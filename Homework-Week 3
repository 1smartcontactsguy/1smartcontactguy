const pizzaToppings = ['ham', 'applewood bacon', 'seasoned pork', 'pepperoni'];

function greetCustomer {
    console.log("Welcome to Pizza House, our toppings are:");
    for (let topping of pizzaToppings) {
        console.log(`- ${topping}`);
    }
}

function getPizzaOrder(size, crust, ...toppings {
    console.log(`One ${size} ${crust} crust pizza with ${toppings.join(', ')} coming up!`);
    return [size, crust, toppings];
}

function preparePizza([size, crust, toppings]) {
    console.log("...Cooking pizza...");
    return {
        size: size,
        crust: crust,
        toppings: toppings
    };
}

function servePizza(pizza) {
    console.log(`Order up! Here's your ${pizza.size} ${pizza.crust} crust pizza with ${pizza.toppings.join(', ')}. Enjoy!`);
    return pizza;
}

greetCustomer();

const order = getPizzaOrder('large', 'thick', 'ham', 'applewood bacon', 'seasoned pork', 'pepperoni');
const pizza = preparePizza(order);
servePizza(pizza);
